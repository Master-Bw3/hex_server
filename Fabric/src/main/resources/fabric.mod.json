{
  "schemaVersion": 1,
  "id": "hex_server",
  "version": "${modVersion}",
  "name": "Hex Server",
  "description": "Hex Server addon for Hex Casting",
  "authors": [
    "Master-Bw3"
  ],
  "contact": {
    "homepage": "https://master-bw3.github.io/hex_server",
    "sources": "https://github.com/Master-Bw3/hex_server"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [{
      "adapter": "kotlin",
      "value": "mod.master_bw3.hex_server.fabric.FabricHexServer"
    }],
    "client": [{
      "adapter": "kotlin",
      "value": "mod.master_bw3.hex_server.fabric.FabricHexServerClient"
    }],
    "modmenu": [{
      "adapter": "kotlin",
      "value": "mod.master_bw3.hex_server.fabric.FabricHexServerModMenu"
    }]
  },
  "mixins": [
    "hex_server-common.mixins.json"
  ],
  "depends": {
    "minecraft": "${versions.minecraft}",
    "fabricloader": ">=${versions.fabric_loader}",
    "fabric-api": ">=${versions.fabric_api}",
    "fabric-language-kotlin": ">=${versions.kotlin_fabric}",
    "architectury": ">=${versions.architectury}",
    "hexcasting": ">=${versions.hexcasting}",
    "cloth-config": ">=${versions.clothConfig}"
  },
  "suggests": {
    "modmenu": ">=${versions.modMenu}"
  }
}
